# Broker selection
TRADING_BROKER=tradier

# ---- Alpaca ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# ---- Iron Condor Strategy Parameters ----
# This runner uses Tradier for SPY, SPX, and XSP market data.
IC_SYMBOL=XSP
DATA_SOURCE=tradier
# Days to expiration: 0 = 0DTE, 1 = 1DTE, etc.
IC_DTE=0
# Delta for short strikes (absolute value, e.g. 0.15 = 15-delta)
IC_SHORT_DELTA=0.15
# Wing width in points (SPX: 10-25, XSP: 1-2.5)
IC_WING_WIDTH=15
# Number of contracts per trade
IC_QUANTITY=1
# Independent positions per strategy. Keep 1 to preserve single-position behavior.
IC_MAX_CONCURRENT_POSITIONS=1
# Minimum spacing between entries when concurrency is enabled.
IC_ENTRY_SPACING_MINUTES=60
# Profit target as % of max credit (0.30 = take profit at 30%)
IC_PROFIT_TARGET=0.30
# Stop loss as multiple of credit received (1.3 = 130%)
IC_STOP_LOSS_MULT=1.3
# Entry time (ET) — format HH:MM
# Max % of portfolio to risk per trade
IC_MAX_ALLOCATION=0.03
# Maximum dollar risk cap per strategy (hard cap)
IC_MAX_POSITION_RISK=15000.0
# Max risk on any single trade as fraction of max_position_risk (e.g. 0.30 = 30%, or leave blank for sliding scale 30%->5%)
IC_MAX_SINGLE_TRADE_PCT=0.30
# Optional aggregate exposure cap across all strategies combined
IC_MAX_PORTFOLIO_RISK=100000.0

# Fee per option contract ($0.40 standard exchange/clearing fee; $3.20 roundtrip per 4-leg IC)
OPTION_FEE_PER_CONTRACT=0.40

# ---- Tradier (Sandbox) ----
# Use Sandbox credentials; populate these blank values in your private .env.
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_NUMBER=
TRADIER_PAPER=true
# Compatibility aliases, used only when TRADIER_PAPER is unset
# TRADIER_IS_PAPER=true
# TRADIER_API_KEY=
# TRADIER_ACCOUNT=
# TRADIER_SANDBOX=1

# ---- Durable package ownership ----
# Relative paths resolve from the project root; containers must share this ledger path.
POSITION_LEDGER_PATH=logs/position_ledger.sqlite3

# ---- Close management and process recovery ----
IC_CLOSE_REPRICE_SECONDS=60
# With market closing disabled, limit retries continue at this maximum aggression.
IC_CLOSE_MAX_REPRICES=3
IC_CLOSE_PRICE_STEP=0.05
IC_CLOSE_ALLOW_MARKET=false
PROCESS_RESTART_BACKOFF_SECONDS=15

# State-changing sandbox verification (leave disabled by default)
RUN_TRADIER_SANDBOX_WRITE_TEST=0
# TRADIER_SANDBOX_TEST_UNDERLYING=XSP
# TRADIER_SANDBOX_TEST_OPTION_SYMBOLS=
# TRADIER_SANDBOX_TEST_CREDIT=99.00

# ---- Neural policy inference (disabled unless explicitly enabled) ----
ML_POLICY_ENABLED=false
ML_MODEL_PATH=logs/models/policy.json
ML_SEQUENCE_LENGTH=12

# ---- Five-minute trajectory logging ----
TRAJECTORY_LOGGING_ENABLED=true
TRAJECTORY_LOG_PATH=logs/trajectories.jsonl
# Run the focused comparison with TRADING_MODE=incubator (single and ab are also supported)
TRADING_MODE=single
# StrategyBro, four dynamic peers, Neural Pure, and one plain IC control.
INCUBATOR_PROFILE=dynamic
# Opt into the legacy parameter sweep with INCUBATOR_PROFILE=full_grid.
# Optional entry count; StrategyBro and dynamic peers come first.
# INCUBATOR_STRATEGY_COUNT=7

# Entry / execution run times (every 5 mins 09:45-10:00, then every 15 mins until 15:30)
IC_ENTRY_TIME=09:45, 09:50, 09:55, 10:00, 10:15, 10:30, 10:45, 11:00, 11:15, 11:30, 11:45, 12:00, 12:15, 12:30, 12:45, 13:00, 13:15, 13:30, 13:45, 14:00, 14:15, 14:30, 14:45, 15:00, 15:15, 15:30

# ---- StrategyBro 90 DTE Dynamic Iron Condor vs Vertical Spread ----
# Enables IC_V25_90DTE_STRATEGYBRO_DYNAMIC in incubator grid
STRATEGYBRO_ENABLED=true
STRATEGYBRO_DTE=90
STRATEGYBRO_ROLL_DTE=30
STRATEGYBRO_WING=15.0
STRATEGYBRO_PT=0.50
STRATEGYBRO_SL=1.3
STRATEGYBRO_OTM_PCT=0.07
STRATEGYBRO_ENTRY_TIME=09:45, 09:50, 09:55, 10:00, 10:15, 10:30, 10:45, 11:00, 11:15, 11:30, 11:45, 12:00, 12:15, 12:30, 12:45, 13:00, 13:15, 13:30, 13:45, 14:00, 14:15, 14:30, 14:45, 15:00, 15:15, 15:30
# STRATEGYBRO_FORCE_SD=  # optional manual SD override for testing/simulation (e.g. 0.2, 0.8, -0.8)

# ---- Dynamic Regime Suite (IC_V26 .. IC_V29) ----
DYNAMIC_STRATEGIES_ENABLED=true

# IC_V26: TrendFlow 10 DTE Momentum Credit Vertical
TRENDFLOW_ENABLED=true
TRENDFLOW_DTE=10
TRENDFLOW_ROLL_DTE=3
TRENDFLOW_DELTA=0.16
TRENDFLOW_WING=5.0
TRENDFLOW_PT=0.50
TRENDFLOW_SL=1.3
TRENDFLOW_MIN_SD=0.35

# IC_V27: Asymmetric Skew 14 DTE Drift-Adjusted Iron Condor
SKEW_DYNAMIC_ENABLED=true
SKEW_DYNAMIC_DTE=14
SKEW_DYNAMIC_ROLL_DTE=5
SKEW_DYNAMIC_PUT_DELTA=0.16
SKEW_DYNAMIC_CALL_DELTA=0.12
SKEW_DYNAMIC_WING=5.0
SKEW_DYNAMIC_PT=0.40
SKEW_DYNAMIC_SL=1.3

# IC_V28: VolCrush Harvester 21 DTE Realized Volatility Spike Strategy
VOL_CRUSH_ENABLED=true
VOL_CRUSH_DTE=21
VOL_CRUSH_ROLL_DTE=7
VOL_CRUSH_DELTA=0.12
VOL_CRUSH_WING=5.0
VOL_CRUSH_PT=0.45
VOL_CRUSH_SL=1.3
VOL_CRUSH_MIN_RV_RATIO=1.15

# IC_V29: Opening-Range Breakout (ORB) 1 DTE Intraday Regime Strategy
ORB_DYNAMIC_ENABLED=true
ORB_DYNAMIC_DTE=1
ORB_DYNAMIC_DELTA=0.15
ORB_DYNAMIC_WING=5.0
ORB_DYNAMIC_PT=0.40
ORB_DYNAMIC_SL=1.3
ORB_DYNAMIC_THRESHOLD_PCT=0.0030

# Dashboard telemetry freshness threshold
DASHBOARD_STALE_AFTER_SECONDS=30

# Tradier Sandbox may have no SPX chains; use XSP or SPY if needed.
# Maximum emergency closing debit as a multiple of entry credit (capped at wing width).
IC_EMERGENCY_CLOSE_MAX_DEBIT_MULT=3.0
# Broker snapshot collection. Both services must share this store.
BROKER_SNAPSHOT_PATH=logs/broker_snapshots.sqlite3
BROKER_BALANCES_INTERVAL=30
BROKER_POSITIONS_INTERVAL=15
BROKER_ORDERS_IDLE_INTERVAL=30
BROKER_ORDERS_ACTIVE_INTERVAL=5
BROKER_QUOTES_INTERVAL=5
# Retain stale values for display for five minutes. Expired values are historical.
BROKER_DISPLAY_MAX_AGE=300

# Optional production market data with paper execution retained. Use one token
# source. Leave both unset to use the execution account's delayed sandbox feed.
# TRADIER_MARKET_DATA_TOKEN_FILE=/run/secrets/tradier_market_data_token
# TRADIER_MARKET_DATA_TOKEN=
# TRADIER_MARKET_DATA_PAPER=false
