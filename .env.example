# Broker selection
TRADING_BROKER=tradier

# ---- Alpaca ----
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# ---- Iron Condor Strategy Parameters ----
# Tradier Sandbox can serve SPY itself. SPX/XSP require a compatible external
# DATA_SOURCE because Sandbox does not supply index data.
IC_SYMBOL=SPY
# DATA_SOURCE=polygon
# Days to expiration: 0 = 0DTE, 1 = 1DTE, etc.
IC_DTE=0
# Delta for short strikes (absolute value, e.g. 0.15 = 15-delta)
IC_SHORT_DELTA=0.15
# Wing width in points (SPX: 10-25, XSP: 1-2.5)
IC_WING_WIDTH=15
# Number of contracts per trade
IC_QUANTITY=1
# Profit target as % of max credit (0.30 = take profit at 30%)
IC_PROFIT_TARGET=0.30
# Stop loss as multiple of credit received (2.0 = 200%)
IC_STOP_LOSS_MULT=2.0
# Entry time (ET) — format HH:MM
IC_ENTRY_TIME=10:00
# Max % of portfolio to risk per trade
IC_MAX_ALLOCATION=0.03
# Maximum total dollar risk across any open positions (hard cap)
IC_MAX_POSITION_RISK=5000.0
# Max risk on any single trade as fraction of max_position_risk (e.g. 0.30 = 30%, or leave blank for sliding scale 30%->5%)
IC_MAX_SINGLE_TRADE_PCT=

# ---- Tradier (Sandbox) ----
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_NUMBER=
TRADIER_PAPER=true
# Compatibility aliases, used only when TRADIER_PAPER is unset
# TRADIER_IS_PAPER=true
# TRADIER_API_KEY=
# TRADIER_ACCOUNT=
# TRADIER_SANDBOX=1

# ---- Durable package ownership ----
POSITION_LEDGER_PATH=logs/position_ledger.sqlite3

# ---- Neural policy inference (disabled unless explicitly enabled) ----
ML_POLICY_ENABLED=false
ML_MODEL_PATH=logs/models/policy.json
ML_SEQUENCE_LENGTH=12

# ---- Five-minute trajectory logging ----
TRAJECTORY_LOGGING_ENABLED=true
TRAJECTORY_LOG_PATH=logs/trajectories.jsonl
# Run the entire grid with TRADING_MODE=incubator (single and ab are also supported)
TRADING_MODE=single
