# ---- ARM64/x86 Python + Node image for Lumibot Reflex Dashboard ----
FROM python:3.11-slim

WORKDIR /app

# Install curl, Node.js, and npm
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY reflex_dashboard/requirements.txt requirements-reflex.txt
RUN pip install --no-cache-dir -r requirements-reflex.txt

# Copy application files
COPY reflex_dashboard/ reflex_dashboard/
COPY dashboard/ dashboard/
COPY strategies/ strategies/
COPY ml/ ml/
COPY trade_logger.py .
COPY USER_FEATURES.md .

WORKDIR /app/reflex_dashboard

ENV REFLEX_DIR=/tmp/reflex
ENV REFLEX_USE_NPM=true
ENV PYTHONUNBUFFERED=1

# Initialize and compile Reflex web assets during build
RUN reflex init

EXPOSE 3000 8000

CMD ["reflex", "run", "--frontend-port", "3000", "--backend-port", "8000"]
